--- /dev/null
+++ b/ggml/src/ggml-sycl/dpct/aot_policy.hpp
@@ -0,0 +1,27 @@
+// Windows ARL-H AOT 构建的设备过滤策略；纯 C++ 实现便于无 GPU 回归。
+#pragma once
+#include <cstddef>
+#include <vector>
+
+namespace dpct_aot {
+struct candidate {
+    bool gpu;
+    bool intel;
+    bool arl_h;
+    bool level_zero;
+};
+
+// 返回原枚举索引，构建连续 DPCT 编号；优先 Level Zero，避免同一 GPU 重复注册。
+inline std::vector<std::size_t> select(const std::vector<candidate> & devices) {
+    bool use_level_zero = false;
+    for (const auto & device : devices)
+        if (device.gpu && device.intel && device.arl_h && device.level_zero) use_level_zero = true;
+    std::vector<std::size_t> selected;
+    for (std::size_t index = 0; index < devices.size(); ++index) {
+        const auto & device = devices[index];
+        if (device.gpu && device.intel && device.arl_h && (!use_level_zero || device.level_zero))
+            selected.push_back(index);
+    }
+    return selected;
+}
+}
