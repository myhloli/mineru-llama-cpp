# SYCL 仅注册 Intel GPU，并为非 Level Zero 路径保留正确集显分类。
diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index d2c1a1a..32aa182 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -6553,10 +6553,12 @@ static void ggml_backend_sycl_device_get_memory(ggml_backend_dev_t dev, size_t *
 static enum ggml_backend_dev_type ggml_backend_sycl_device_get_type(ggml_backend_dev_t dev) {
     ggml_backend_sycl_device_context * ctx = (ggml_backend_sycl_device_context *)dev->context;
     const sycl_device_info & info = ggml_sycl_info().devices[ctx->device];
-    if (info.l0_device_type_valid && !info.l0_discrete_gpu) {
-        return GGML_BACKEND_DEVICE_TYPE_IGPU;
+    if (info.l0_device_type_valid) {
+        return info.l0_discrete_gpu ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_IGPU;
     }
-    return GGML_BACKEND_DEVICE_TYPE_GPU;
+    // OpenCL 路径没有 Level Zero 分类时，使用标准设备属性，避免 Intel 集显优先于独显。
+    const auto & device = dpct::dev_mgr::instance().get_device(ctx->device);
+    return device.get_info<sycl::info::device::host_unified_memory>() ? GGML_BACKEND_DEVICE_TYPE_IGPU : GGML_BACKEND_DEVICE_TYPE_GPU;
 }
 
 static void ggml_backend_sycl_device_get_props(ggml_backend_dev_t dev, ggml_backend_dev_props * props) {
@@ -7472,6 +7474,11 @@ ggml_backend_reg_t ggml_backend_sycl_reg() {
             const int min_batch_size = getenv("GGML_OP_OFFLOAD_MIN_BATCH") ? atoi(getenv("GGML_OP_OFFLOAD_MIN_BATCH")) : 32;
 
             for (int i = 0; i < ggml_sycl_info().device_count; i++) {
+                // 本构建仅支持 INTEL target；AMD/NVIDIA 的 OpenCL 设备不能冒充可用 SYCL GPU。
+                const auto & device = dpct::dev_mgr::instance().get_device(i);
+                if (!device.is_gpu() || device.get_info<sycl::info::device::vendor_id>() != 0x8086) {
+                    continue;
+                }
                 ggml_backend_sycl_device_context * dev_ctx = new ggml_backend_sycl_device_context;
                 dev_ctx->device = i;
                 dev_ctx->name = GGML_SYCL_NAME + std::to_string(i);
